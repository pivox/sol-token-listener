{
  "name": "solana-token-listener",
  "version": "0.1.0",
  "private": true,
  "description": "Observation et paper trading de nouveaux tokens Pump.fun, avec Raydium CPMM conservé comme adaptateur secondaire.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start": "node dist/src/app.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "rpc:check": "tsx scripts/check-rpc.ts",
    "pool:diagnose": "tsx scripts/diagnose-pool.ts",
    "tx:diagnose": "tsx scripts/diagnose-transaction.ts",
    "fixture:capture": "tsx scripts/capture-fixture.ts"
  },
  "dependencies": {
    "@raydium-io/raydium-sdk-v2": "0.2.59-alpha",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.2",
    "bs58": "6.0.0",
    "dotenv": "17.4.2",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bn.js": "5.1.6",
    "@types/node": "24.0.0",
    "@types/pg": "8.15.0",
    "eslint": "^9.39.5",
    "tsx": "4.23.1",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
