{
  "name": "solana-token-listener",
  "version": "0.1.0",
  "private": true,
  "description": "Observation et paper trading de nouveaux tokens Pump.fun, avec Raydium CPMM conservé comme adaptateur secondaire.",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start": "node dist/src/app.js",
    "executor:dev": "tsx src/executor/main.ts",
    "executor:start": "node dist/src/executor/main.js",
    "build": "npm run build:backend && npm run build --workspace frontend",
    "build:backend": "tsc -p tsconfig.json && tsx scripts/copy-migrations.ts && tsx scripts/copy-qualification-profiles.ts",
    "check": "npm run check:backend && npm run check --workspace frontend",
    "check:backend": "npm run pumpfun:check-generated && npm run pumpswap:check-generated && tsc -p tsconfig.json --noEmit",
    "lint": "npm run lint:backend && npm run lint --workspace frontend",
    "lint:backend": "eslint src tests scripts --max-warnings=0 --ignore-pattern scripts/deployment-smoke.mjs --ignore-pattern scripts/validate-deployment-images.mjs && node --check scripts/deployment-smoke.mjs && node --check scripts/validate-deployment-images.mjs",
    "test": "npm run test:backend && npm test --workspace frontend",
    "test:backend": "tsx --test tests/*.test.ts",
    "frontend:dev": "npm run dev --workspace frontend",
    "frontend:e2e": "npm run e2e --workspace frontend",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:compiled": "node dist/scripts/migrate.js",
    "db:purge": "tsx scripts/purge-retained-data.ts --once",
    "db:purge:compiled": "node dist/scripts/purge-retained-data.js --once",
    "retention:start:compiled": "node dist/scripts/purge-retained-data.js",
    "deployment:healthcheck:compiled": "node dist/scripts/deployment-healthcheck.js",
    "deployment:validate-images": "node scripts/validate-deployment-images.mjs",
    "deployment:smoke": "node scripts/deployment-smoke.mjs",
    "deployment:smoke:signal": "node scripts/deployment-smoke.mjs --signal-fault-probe",
    "rpc:check": "tsx scripts/check-rpc.ts",
    "rpc:soak": "tsx scripts/rpc-soak.ts",
    "paper:dry-run": "tsx src/cli/paper-dry-run.ts",
    "paper:mvp": "tsx src/cli/paper-mvp.ts",
    "pool:diagnose": "tsx scripts/diagnose-pool.ts",
    "tx:diagnose": "tsx scripts/diagnose-transaction.ts",
    "fixture:capture": "tsx scripts/capture-fixture.ts",
    "inbox:recover": "tsx scripts/recover-inbox.ts",
    "pumpfun:generate": "tsx scripts/generate-pumpfun-idl.ts",
    "pumpfun:check-generated": "tsx scripts/generate-pumpfun-idl.ts --check",
    "pumpswap:generate": "tsx scripts/generate-pumpswap-idl.ts",
    "pumpswap:check-generated": "tsx scripts/generate-pumpswap-idl.ts --check",
    "docs:check": "tsx scripts/check-system-overview.ts"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "1.36.0",
    "@pump-fun/pump-swap-sdk": "1.19.0",
    "@solana/spl-token": "0.4.15",
    "@solana/spl-token-metadata": "0.1.6",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.5",
    "bs58": "6.0.0",
    "dotenv": "17.4.2",
    "parse5": "8.0.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "tldts": "7.4.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bn.js": "5.2.0",
    "@types/node": "24.0.0",
    "@types/pg": "8.21.0",
    "eslint": "^9.39.5",
    "jsdom": "28.1.0",
    "tsx": "4.23.12",
    "typescript": "5.8.3",
    "typescript-eslint": "8.67.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
