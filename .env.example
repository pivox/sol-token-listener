SOLANA_CLUSTER=mainnet-beta
SOLANA_HTTP_RPC_URL=
SOLANA_HTTP_RPC_FALLBACK_URLS=
SOLANA_WS_RPC_URL=
SOLANA_WS_RPC_FALLBACK_URLS=
SOLANA_COMMITMENT=confirmed
SOLANA_FINALITY_COMMITMENT=finalized
# Read-only, bounded RPC qualification command. These values do not enable it at startup.
RPC_SOAK_DURATION_SECONDS=60
RPC_SOAK_INTERVAL_MS=1000

RAYDIUM_CPMM_PROGRAM_ID=CPMMoo8L3F4NbTegBCKVNunggL7H1ZpdTHKxQB5qKP1C
RAYDIUM_BURN_AND_EARN_PROGRAM_ID=LockrWmn6K5twhz3y9w1dQERbmgSaRkfnTeTKbpofwE
WSOL_MINT=So11111111111111111111111111111111111111112

DATABASE_URL=postgresql://solanabot:solanabot@127.0.0.1:5432/solanabot
POSTGRES_AUTO_MIGRATE=false

EXECUTION_MODE=observe
PAPER_QUOTE_MINT_ALLOWLIST=So11111111111111111111111111111111111111112
PAPER_STRATEGY_ENABLED=false
PAPER_STRATEGY_ID=validated-external-buys
PAPER_STRATEGY_VERSION=1
PAPER_ENTRY_QUOTE_AMOUNT_RAW=
PAPER_EXTERNAL_BUY_TARGET=10
PAPER_MINIMUM_CONFIRMATION=confirmed
PAPER_ENTRY_WINDOW_SECONDS=45
PAPER_QUOTE_MAX_AGE_MS=5000
PAPER_QUOTE_MAX_SLOT_LAG=32
PAPER_SLIPPAGE_BPS=
PAPER_DECISION_WORKER_POLL_MS=1000
PAPER_DECISION_WORKER_LEASE_SECONDS=30
PAPER_DECISION_RETRY_MAX_ATTEMPTS=5
PAPER_DECISION_RETRY_BASE_DELAY_MS=500
CREATION_STRATEGY_ENABLED=false
CREATION_ENTRY_MAX_AGE_MS=45000
CREATION_ENTRY_MAX_SLOT_LAG=32
EXTERNAL_UNIQUE_BUYERS_TARGET=10
EXTERNAL_MIN_BUY_AMOUNT_RAW=
CREATION_TAKE_PROFIT_MULTIPLIER_BPS=20000
CREATION_MANUAL_KILL_SWITCH=false
# `paper:mvp` also requires Mainnet, this creation strategy, the listener,
# paper mode, and the exact one-mint WSOL allowlist. Provider usage is
# unavailable until an authoritative usage adapter exists.
DATA_RETENTION_HOURS=4
RETENTION_PURGE_INTERVAL_MS=900000
QUALIFICATION_PROFILE_PATH=
QUALIFICATION_MIN_SCORE=
QUALIFICATION_RULE_SET_STATUS=UNVALIDATED_RULE_SET

BUY_AMOUNT_SOL=0.01
SLIPPAGE_BPS=1500
MAX_PRIORITY_FEE_LAMPORTS=
COMPUTE_UNIT_LIMIT=400000

TARGET_BUYS_AFTER_ENTRY=10
MAX_CONCURRENT_POSITIONS=1
MAX_ACTIVE_POOL_MONITORS=50
POOL_MONITOR_TTL_MINUTES=90
RECONCILE_SECONDS=15
# Durable per-cycle retry policy. Attempts include the first claim; backoff caps at 60 seconds.
RPC_RETRY_MAX_ATTEMPTS=5
RPC_RETRY_BASE_DELAY_MS=500

# Active observation-only listener; requires PostgreSQL plus Solana HTTP and WebSocket RPC.
# live-edge reads one page per scan; strict may read MAX_PAGES * PAGE_SIZE per program.
# No private key, signing, simulation submission, or live transaction setting exists.
LISTENER_ENABLED=true
LISTENER_WORKER_LEASE_SECONDS=120
LISTENER_CATCH_UP_POLICY=live-edge
LISTENER_CATCH_UP_MAX_PAGES=20
LISTENER_CATCH_UP_PAGE_SIZE=100
LISTENER_FINALITY_MISSING_POLLS=3
LISTENER_SHUTDOWN_TIMEOUT_MS=30000

# Public unauthenticated metadata/social reads. No X or Telegram credential is used.
SOCIAL_HTTP_TIMEOUT_MS=5000
SOCIAL_HTTP_MAX_BYTES=262144
SOCIAL_HTTP_MAX_REDIRECTS=3
SOCIAL_HTTP_CONCURRENCY=2
SOCIAL_WORKER_POLL_MS=1000
SOCIAL_WORKER_LEASE_SECONDS=30
SOCIAL_RETRY_MAX_ATTEMPTS=3
SOCIAL_RETRY_BASE_DELAY_MS=1000

RISK_POLICY=allow-only
RISK_MIN_SCORE=80
RISK_ALLOW_UNKNOWN_REVIEWS=false
RISK_ALLOW_UNKNOWN_MIN_SCORE=95

MIN_WSOL_LIQUIDITY=0.25
RISK_MAX_TRANSFER_FEE_BPS=1500
RISK_MAX_BUY_PRICE_IMPACT_BPS=
RISK_MAX_SELL_PRICE_IMPACT_BPS=
RISK_MAX_ROUNDTRIP_LOSS_BPS=3000
RISK_BUY_SIMULATION_REQUIRED=true
RISK_REVERSE_QUOTE_REQUIRED=true

RISK_MAX_TOP1_HOLDER_BPS=
RISK_MAX_TOP5_HOLDERS_BPS=
RISK_MAX_TOP10_HOLDERS_BPS=

DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
DASHBOARD_REFRESH_SECONDS=5
DASHBOARD_MAX_ROWS=250
DASHBOARD_ACTIONS_ENABLED=false
API_ENABLED=true
API_HOST=127.0.0.1
API_PORT=3000
API_PAGE_LIMIT_DEFAULT=50
API_PAGE_LIMIT_MAX=200
API_HOLDER_POSITION_LIMIT=100
API_HOLDER_SNAPSHOT_LIMIT=100
API_WALLET_CLUSTER_LIMIT=50
