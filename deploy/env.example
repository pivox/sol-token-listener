# Copy this file outside version control (for example to /etc/sol-token-listener/deploy.env).
# Every placeholder below must be replaced before deployment.
# POSTGRES_PASSWORD_URI_ENCODED must be the percent-encoding of POSTGRES_PASSWORD.
# These unreserved example values can be identical; reserved characters must be encoded.
POSTGRES_DB=sol_token_listener
POSTGRES_USER=sol_token_listener
POSTGRES_PASSWORD=replace-with-a-secret
POSTGRES_PASSWORD_URI_ENCODED=replace-with-a-secret

# Use a real, authenticated Solana RPC provider. These documentation-only hosts cannot work.
SOLANA_HTTP_RPC_URL=https://rpc-provider.invalid
SOLANA_WS_RPC_URL=wss://rpc-provider.invalid

# The frontend is deliberately published to loopback only. Put TLS/reverse proxy in front of it.
FRONTEND_PORT=8080
LISTENER_ENABLED=true
RETENTION_PURGE_INTERVAL_MS=900000
