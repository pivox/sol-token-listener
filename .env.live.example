# Copiez ces variables dans un gestionnaire de secrets ou dans l'environnement du processus.
# La commande live:config-check n'ouvre aucun fichier de secrets et n'envoie aucune requête.
# LIVE_RPC_URL est consommé uniquement par live:network-preflight et ne doit jamais être journalisé.
LIVE_RPC_URL=
LIVE_ENABLE=false
LIVE_EXPECTED_GENESIS_HASH=
LIVE_EXPECTED_WALLET=
LIVE_KEYPAIR_FILE=
LIVE_BUY_AMOUNT_LAMPORTS=
LIVE_MAX_EXPOSURE_LAMPORTS=
LIVE_MAX_LOSS_LAMPORTS=
# Minimum native SOL that a new BUY must leave after its full spend, network fee and any required base ATA rent.
# A tracked SELL may spend this reserve. Must be greater than LIVE_MAX_PRIORITY_FEE_LAMPORTS.
LIVE_EXIT_RESERVE_LAMPORTS=
# Maximum requested priority fee per signed transaction (lamports; 0 forbids priority fees).
# Maximum requested prioritization fee per transaction; not a spend target or a cap on base/protocol fees/rent.
LIVE_MAX_PRIORITY_FEE_LAMPORTS=
LIVE_MAX_SLIPPAGE_BPS=
LIVE_MAX_BUYS=1
LIVE_MAX_SESSION_SECONDS=

# Runtime observe/live transport and explicit target database. These are inherited
# from the process environment by live:run; live CLIs do not load this file.
# Endpoint URLs and database DSNs may contain credentials and must be treated as secrets.
SOLANA_HTTP_RPC_URL=
SOLANA_WS_RPC_URL=
DATABASE_URL=
SOLANA_CLUSTER=mainnet-beta
SOLANA_COMMITMENT=confirmed
SOLANA_FINALITY_COMMITMENT=finalized
LISTENER_ENABLED=true
POSTGRES_AUTO_MIGRATE=false

# Safe observation defaults. Keep paper execution disabled during observation.
EXECUTION_MODE=observe
PAPER_STRATEGY_ENABLED=false
QUOTE_OBSERVATION_ENABLED=true
QUOTE_OBSERVATION_PATH=data/quote-observations.v1.jsonl
API_ENABLED=false
DASHBOARD_ENABLED=false

# Used only by the read-only operator tools, never inferred by live:run.
LIVE_OPERATOR_DATABASE_URL=
LIVE_OPERATOR_HTTP_RPC_URL=
